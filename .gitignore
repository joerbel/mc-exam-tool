# Whitelist: nur die Plattform wird versioniert.
# Kursunterlagen (unterlagen/, folien/, buecher/, themenliste.txt) bleiben lokal.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/pruefung/

